{% set members = this.members %}

{% set components = [
    {label: 'TypeInfo', meta: 'symfony/symfony#52510', url: 'https://github.com/symfony/symfony/pull/52510', authors: [members['mathias-arlaud']]},
    {label: 'JsonStreamer', meta: 'symfony/symfony#51718', url: 'https://github.com/symfony/symfony/pull/51718', authors: [members['mathias-arlaud']]},
    {label: 'PasswordHasher', meta: 'symfony/symfony#39802', url: 'https://github.com/symfony/symfony/pull/39802', authors: [members['robin-chalas']]},
    {label: 'UX Map', meta: 'symfony/ux#1937', url: 'https://github.com/symfony/ux/pull/1937', authors: [members['hugo-alliaume']]},
    {label: 'UX Translator', meta: 'symfony/ux#616', url: 'https://github.com/symfony/ux/pull/616', authors: [members['hugo-alliaume']]},
] %}

{% set talks = this.talks|map(talk => {
    label: talk.title,
    meta: talk.event,
    url: talk.url,
    authors: talk.speakers|map(id => members[id.value]),
    thumbnail: 'images/talks/' ~ talk.youtubeId ~ '.webp',
}) %}

{% set diff_lines = [
    {type: 'ctx', text: '// ' ~ 'home.values.filename'|trans},
    {type: 'ctx', text: ''},
    {type: 'del', text: 'home.values.line_1_del'|trans},
    {type: 'add', text: 'home.values.line_1_add_1'|trans},
    {type: 'add', text: 'home.values.line_1_add_2'|trans},
    {type: 'link', icon: 'mdi:github', label: 'home.values.proof.pull_requests'|trans({count: this.symfonyPullRequestsCount}), url: this.symfonyPullRequestsUrl},
    {type: 'ctx', text: ''},
    {type: 'del', text: 'home.values.line_2_del'|trans},
    {type: 'add', text: 'home.values.line_2_add_1'|trans},
    {type: 'refs', icon: 'mdi:github', summary: 'home.values.proof.components'|trans({count: components|length}), items: components},
    {type: 'add', text: 'home.values.line_2_add_2'|trans},
    {type: 'link', icon: 'mdi:github', label: 'home.values.proof.bug_fixes'|trans({count: this.symfonyBugFixesCount}), url: this.symfonyBugFixesUrl},
    {type: 'ctx', text: ''},
    {type: 'del', text: 'home.values.line_3_del'|trans},
    {type: 'add', text: 'home.values.line_3_add_1'|trans},
    {type: 'add', text: 'home.values.line_3_add_2'|trans},
    {type: 'refs', summary: 'home.values.proof.talks'|trans({count: talks|length}), items: talks},
    {type: 'ctx', text: ''},
    {type: 'del', text: 'home.values.line_4_del'|trans},
    {type: 'add', text: 'home.values.line_4_add_1'|trans},
    {type: 'add', text: 'home.values.line_4_add_2'|trans},
] %}

{% set additions = diff_lines|filter(l => l.type == 'add')|length %}
{% set deletions = diff_lines|filter(l => l.type == 'del')|length %}

<section id="values" aria-label="{{ 'home.values.aria_label'|trans }}">
    <div class="container max-w-screen-xl mx-auto px-4 sm:px-8 xl:px-4">
        <twig:Home:Heading transKey="home.values.heading" />

        <div class="bg-paper border border-ink/10 rounded-2xl overflow-hidden shadow-lg">
            <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-3 border-b border-ink/10 font-mono text-xs text-muted">
                <span class="inline-flex items-center gap-1.5">
                    <twig:ux:icon name="mdi:circle" aria-hidden="true" class="size-2 text-accent" />
                    <span class="text-accent font-bold">feat/values</span>
                    <span class="ml-1 hidden md:inline-block">{{ 'home.values.commit_meta'|trans }}</span>
                </span>
                <span>
                    <span class="text-green-800 font-bold">+{{ additions }}</span>
                    <span class="ml-2 text-red-700 font-bold">−{{ deletions }}</span>
                </span>
            </div>

            <ol role="list" class="list-none font-mono text-sm sm:text-base leading-loose py-4 m-0 p-0">
                {% for line in diff_lines %}
                    {% set is_blank = line.type == 'ctx' and line.text is empty %}
                    {% set line_n = diff_lines|slice(0, loop.index)|filter(l => l.type != 'del')|length + (line.type == 'del' ? 1 : 0) %}
                    <li
                        {% if is_blank %}aria-hidden="true"{% endif %}
                        class="group/line flex min-h-8 {% if line.type == 'add' %}bg-green-500/10{% elseif line.type == 'del' %}bg-red-500/10{% endif %}"
                    >
                        <span aria-hidden="true" class="w-10 sm:w-16 shrink-0 pr-2 sm:pr-4 text-right text-muted text-sm leading-loose border-r border-ink/10 select-none">
                            {{ line_n }}
                        </span>
                        <span aria-hidden="true" class="w-6 sm:w-10 shrink-0 text-center font-bold select-none {% if line.type == 'add' %}text-green-700{% elseif line.type == 'del' %}text-red-700{% endif %}">
                            {% if line.type == 'add' %}+{% elseif line.type == 'del' %}−{% elseif line.type == 'link' %}<twig:ux:icon :name="line.icon" class="inline-block size-4 align-[-0.2em] text-accent" />{% elseif line.type == 'refs' %}<twig:ux:icon name="mdi:chevron-right" class="inline-block size-4 align-[-0.2em] text-accent transition-transform duration-200 group-has-[details[open]]/line:rotate-90" />{% endif %}
                        </span>
                        {% if line.type == 'link' %}
                            <span data-test-proof class="flex-1 pr-4 sm:pr-6">
                                <span class="sr-only">{{ 'home.values.sr_proof'|trans }} </span>
                                <a
                                    href="{{ line.url }}"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="group inline-flex items-center gap-1 text-accent no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-sm"
                                >
                                    <span class="underline decoration-accent/30 underline-offset-2 group-hover:decoration-accent">{{ line.label }}</span>
                                    <span class="sr-only">{{ 'common.opens_new_tab'|trans }}</span>
                                </a>
                            </span>
                        {% elseif line.type == 'refs' %}
                            {% set authors = [] %}
                            {% for item in line.items %}
                                {% for author in item.authors %}
                                    {% if author not in authors %}
                                        {% set authors = authors|merge([author]) %}
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                            <details data-test-proof class="group/refs flex-1 min-w-0 pr-4 sm:pr-6">
                                <summary class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 py-1 cursor-pointer list-none text-accent rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-accent [&::-webkit-details-marker]:hidden">
                                    <span class="sr-only">{{ 'home.values.sr_proof'|trans }} </span>
                                    <span class="flex -space-x-1.5" aria-hidden="true">
                                        {% for author in authors %}
                                            <img
                                                src="{{ asset('images/team/members/' ~ author.id.value ~ '.webp') }}"
                                                alt=""
                                                width="20"
                                                height="20"
                                                loading="lazy"
                                                class="size-5 rounded-full object-cover bg-paper-shade ring-2 ring-paper"
                                            >
                                        {% endfor %}
                                    </span>
                                    <span class="underline decoration-accent/30 underline-offset-2 hover:decoration-accent">{{ line.summary }}</span>
                                    <span data-test-proof-authors class="sr-only sm:not-sr-only text-muted">· {{ authors|map(a => a.firstName)|join(', ') }}</span>
                                </summary>

                                <ul role="list" class="list-none m-0 mt-3 mb-2 p-0 gap-2 flex overflow-x-auto snap-x snap-mandatory [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:grid sm:overflow-visible sm:grid-cols-2 lg:grid-cols-3">
                                    {% for item in line.items %}
                                        <li class="w-48 shrink-0 snap-start sm:w-auto">
                                            <a
                                                href="{{ item.url }}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="group/ref flex h-full flex-col sm:flex-row sm:items-center gap-3 rounded-xl border border-ink/10 bg-paper p-2 no-underline transition duration-200 hover:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                                            >
                                                {% if item.thumbnail is defined %}
                                                    <img
                                                        src="{{ asset(item.thumbnail) }}"
                                                        alt=""
                                                        width="320"
                                                        height="180"
                                                        loading="lazy"
                                                        class="w-full sm:w-24 shrink-0 aspect-video rounded-md object-cover bg-paper-shade"
                                                    >
                                                {% else %}
                                                    <span class="grid place-items-center size-10 shrink-0 rounded-md bg-ink text-paper group-hover/ref:bg-accent transition-colors" aria-hidden="true">
                                                        <twig:ux:icon :name="line.icon" class="size-5" />
                                                    </span>
                                                {% endif %}
                                                <span class="flex min-w-0 flex-1 flex-col gap-0.5 font-sans text-sm leading-snug">
                                                    <span class="font-medium text-ink group-hover/ref:text-accent transition-colors break-words line-clamp-3 sm:line-clamp-2">{{ item.label }}</span>
                                                    <span class="font-mono text-xs text-muted">{{ item.meta }}</span>
                                                    <span class="flex items-center gap-1.5 pt-0.5 text-xs text-ink-soft">
                                                        <span class="flex -space-x-1.5" aria-hidden="true">
                                                            {% for author in item.authors %}
                                                                <img
                                                                    src="{{ asset('images/team/members/' ~ author.id.value ~ '.webp') }}"
                                                                    alt=""
                                                                    width="20"
                                                                    height="20"
                                                                    loading="lazy"
                                                                    class="size-5 rounded-full object-cover bg-paper-shade ring-2 ring-paper"
                                                                >
                                                            {% endfor %}
                                                        </span>
                                                        {{ item.authors|map(a => a.firstName)|join(', ') }}
                                                    </span>
                                                </span>
                                                <span class="sr-only">{{ 'common.opens_new_tab'|trans }}</span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </details>
                        {% else %}
                            <span class="flex-1 pr-4 sm:pr-6 {% if line.type == 'del' %}line-through text-muted{% elseif line.type == 'add' %}text-ink{% else %}text-ink-soft{% endif %}">
                                {% if line.type == 'add' %}<span class="sr-only">{{ 'home.values.sr_added'|trans }} </span>{% endif %}
                                {% if line.type == 'del' %}<span class="sr-only">{{ 'home.values.sr_removed'|trans }} </span>{% endif %}
                                {% if line.text %}{{ line.text }}{% else %}&nbsp;{% endif %}
                            </span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        </div>
    </div>
</section>
